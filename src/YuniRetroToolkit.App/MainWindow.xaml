<Window x:Class="YuniRetroToolkit.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YuniRetroToolkit.App" Style="{DynamicResource {x:Type Window}}" Title="{DynamicResource AppTitle}" Width="1440" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
      <DockPanel><TextBlock Text="{DynamicResource AppTitle}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="日本語" Click="Japanese_Click" AutomationProperties.Name="日本語に切り替え"/><Button Content="English" Margin="8,3,0,3" Click="English_Click" AutomationProperties.Name="Switch to English"/><Button Content="◐ Theme" Margin="8,3,0,3" Click="Theme_Click" AutomationProperties.Name="テーマ切り替え"/></StackPanel></DockPanel>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
        <StackPanel><TextBlock Text="{DynamicResource Mode}" FontWeight="SemiBold" Margin="4,0,0,8"/><Button x:Name="NavEditButton" Tag="edit" Click="Nav_Click" Content="{DynamicResource NavEdit}" Background="{DynamicResource AccentSoftBrush}"/><Button x:Name="NavPreviewButton" Tag="preview" Click="Nav_Click" Content="{DynamicResource NavPreview}"/><Button x:Name="NavBackupButton" Tag="backup" Click="Nav_Click" Content="{DynamicResource NavBackup}"/><Button x:Name="NavVerifyButton" Tag="verify" Click="Nav_Click" Content="{DynamicResource NavVerify}"/><Button x:Name="NavGuideButton" Tag="guide" Click="Nav_Click" Content="{DynamicResource GuideButton}" AutomationProperties.Name="{DynamicResource GuideButton}"/><Separator Margin="0,14"/><TextBlock Text="{DynamicResource Files}" FontWeight="SemiBold" Margin="4,0,0,8"/><DockPanel KeyboardNavigation.TabNavigation="Local"><Button KeyboardNavigation.TabIndex="1" DockPanel.Dock="Right" Content="ⓘ" Width="38" Margin="6,3,0,3" HorizontalContentAlignment="Center" Click="Info_Click" AutomationProperties.Name="{DynamicResource InfoButton}"/><Button x:Name="OpenButton" KeyboardNavigation.TabIndex="0" Content="{DynamicResource OpenFiles}" Click="Open_Click" ToolTip="{DynamicResource OpenTip}" local:AccessibleToolTipBehavior.OpenOnKeyboardFocus="True"/></DockPanel><Button x:Name="OpenGenericButton" Content="{DynamicResource OpenGeneric}" Click="OpenGeneric_Click" HorizontalContentAlignment="Center" Margin="0,6,0,0" AutomationProperties.Name="{DynamicResource OpenGenericName}"/><Button x:Name="OpenDemoButton" Content="{DynamicResource OpenDemo}" Click="OpenDemo_Click" HorizontalContentAlignment="Center" Margin="0,6,0,0" AutomationProperties.HelpText="{DynamicResource OpenDemoTip}"/><TextBlock Text="{DynamicResource OriginalReadOnly}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,10,4,4"/><TextBlock x:Name="SavePathText" Text="{DynamicResource NotSelected}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4"/></StackPanel>
      </Border>
      <ScrollViewer Focusable="False" Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,22" MaxWidth="820">
        <TextBlock x:Name="WorkflowTitle" Text="{DynamicResource EditTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" x:Name="WorkflowSubtitle" Text="{DynamicResource EditSubtitle}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,20"/>
        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,18"><TextBlock x:Name="StatusText" Text="1. セーブと ROM を選んでください。完全一致する定義で作業コピーを開きます。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Focusable="True" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,14"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock Text="{DynamicResource DisplayMode}" VerticalAlignment="Center" Margin="0,0,8,0"/><RadioButton x:Name="SimpleModeButton" GroupName="V2Mode" Content="Simple" IsChecked="True" Checked="V2Mode_Checked" AutomationProperties.Name="Simple mode"/><RadioButton x:Name="AdvancedModeButton" GroupName="V2Mode" Content="Advanced" Margin="12,0,0,0" Checked="V2Mode_Checked" AutomationProperties.Name="Advanced mode"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="{DynamicResource EditSlot}" VerticalAlignment="Center" Margin="18,0,8,0"/><ComboBox x:Name="SlotSelector" MinWidth="150" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="SlotSelector_SelectionChanged" AutomationProperties.Name="{DynamicResource EditSlotName}"/></StackPanel></DockPanel></Border>
        <TextBlock Text="{DynamicResource Step1}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{DynamicResource Step2}" Margin="0,8,0,0" FontWeight="SemiBold" FontSize="17"/><TextBlock TextWrapping="Wrap" x:Name="DefinitionText" Text="{DynamicResource NoDefinition}" Foreground="{DynamicResource MutedBrush}" Margin="24,3,0,14"/>
        <TextBlock Text="{DynamicResource Step3}" FontWeight="SemiBold" FontSize="17"/><DockPanel Margin="0,8,0,4"><Button x:Name="QuickEditAddButton" DockPanel.Dock="Right" Content="{DynamicResource QuickEditAddLabel}" Click="QuickEditAdd_Click" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource QuickEditAddName}"/><Button x:Name="FavoriteButton" DockPanel.Dock="Right" Content="{DynamicResource FavoriteLabel}" Click="Favorite_Click" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource FavoriteName}"/><TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" AutomationProperties.Name="{DynamicResource SearchName}" ToolTip="{DynamicResource SearchTip}"/></DockPanel><TextBlock x:Name="SearchEmptyText" Text="" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ListBox x:Name="FavoriteList" DisplayMemberPath="Label" SelectedValuePath="FieldId" SelectionChanged="FavoriteList_SelectionChanged" MaxHeight="80" Margin="0,4,0,4" AutomationProperties.Name="{DynamicResource FavoritesName}"/><DataGrid x:Name="FieldsGrid" IsEnabled="False" AutomationProperties.Name="{DynamicResource FieldsGridName}" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MinHeight="180" MaxHeight="300" Margin="0,8,0,14" SelectionChanged="FieldsGrid_SelectionChanged"><DataGrid.Resources><Style x:Key="WrappedFieldCell" TargetType="{x:Type TextBlock}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="None"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="1.1*" ElementStyle="{StaticResource WrappedFieldCell}"/><DataGridTextColumn Header="Field" Binding="{Binding Label}" Width="1.8*" ElementStyle="{StaticResource WrappedFieldCell}"/><DataGridTextColumn Header="Value" Binding="{Binding CurrentValue}" Width="0.6*"/><DataGridTextColumn Header="Safe range" Binding="{Binding SafeRange}" Width="1*" ElementStyle="{StaticResource WrappedFieldCell}"/><DataGridTextColumn Header="Verification" Binding="{Binding Verification}" Width="1.2*" ElementStyle="{StaticResource WrappedFieldCell}"/></DataGrid.Columns></DataGrid>
        <Expander x:Name="QuickEditPanel" Header="{DynamicResource QuickEditHeader}" Margin="0,0,0,12" IsExpanded="True"><StackPanel><TextBlock x:Name="QuickEditHint" Text="Advancedで項目を選び、クイック編集に追加できます。" TextWrapping="Wrap"/><ItemsControl x:Name="QuickEditList" AutomationProperties.Name="{DynamicResource QuickEditListName}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource QuickEditRemove}" Tag="{Binding}" Click="QuickEditRemove_Click" AutomationProperties.Name="{Binding RemoveName}"/><Button DockPanel.Dock="Right" Content="{DynamicResource QuickEditApply}" Tag="{Binding}" Click="QuickEditApply_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding ApplyName}"/><TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NumberVisibility}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Detail}"/><ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedOption}" Visibility="{Binding EnumVisibility}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Detail}"/><CheckBox IsChecked="{Binding CheckedValue}" Visibility="{Binding BooleanVisibility}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Detail}"/></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
        <TextBlock Text="{DynamicResource Step4}" FontWeight="SemiBold" FontSize="17"/><DockPanel KeyboardNavigation.TabNavigation="Local" Margin="0,8,0,6"><Button x:Name="ApplyButton" IsEnabled="False" KeyboardNavigation.TabIndex="1" DockPanel.Dock="Right" Content="{DynamicResource Apply}" Click="Apply_Click" MinWidth="90" Margin="8,0,0,0" HorizontalContentAlignment="Center"/><TextBox x:Name="ValueText" IsEnabled="False" TextChanged="Input_TextChanged" KeyboardNavigation.TabIndex="0" AutomationProperties.Name="{DynamicResource NewValue}" ToolTip="{DynamicResource ValueTip}" local:AccessibleToolTipBehavior.OpenOnKeyboardFocus="True"/></DockPanel>
        <TextBlock x:Name="ValidationText" Text="READ ONLY: 検証済みの作業コピーを開いてください。" TextWrapping="Wrap" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{DynamicResource Step5}" FontWeight="SemiBold" FontSize="17"/><WrapPanel Margin="0,8"><Button x:Name="UndoButton" IsEnabled="False" Content="{DynamicResource Undo}" Click="Undo_Click"/><Button x:Name="RedoButton" IsEnabled="False" Content="{DynamicResource Redo}" Click="Redo_Click" Margin="8,3,0,3"/><Button x:Name="PreviewButton" IsEnabled="False" Content="{DynamicResource RefreshPreview}" Click="Preview_Click" Margin="8,3,0,3"/></WrapPanel><TextBox x:Name="PreviewText" AutomationProperties.Name="{DynamicResource PreviewName}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto"/><Button x:Name="ExportButton" IsEnabled="False" Content="{DynamicResource ExportNew}" Click="Export_Click" Background="{DynamicResource AccentSoftBrush}" HorizontalContentAlignment="Center" FontWeight="SemiBold" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer>
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="{DynamicResource Details}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Metadata" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock x:Name="MetadataText" Text="{DynamicResource MetadataHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock Text="Safety" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock x:Name="SafetyStatusText" Text="{DynamicResource SafetyText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="Help" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock x:Name="HelpText" Text="{DynamicResource HelpHint}" TextWrapping="Wrap"/><Expander x:Name="TutorialPanel" Header="{DynamicResource TutorialHeader}" Margin="0,8,0,0"><StackPanel Margin="0,8"><TextBlock x:Name="TutorialProgressText" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="TutorialTitleText" FontWeight="SemiBold" TextWrapping="Wrap" Focusable="True" AutomationProperties.HeadingLevel="Level2"/><TextBlock x:Name="TutorialBodyText" TextWrapping="Wrap" Margin="0,4,0,6"/><WrapPanel><Button x:Name="TutorialDemoButton" Content="{DynamicResource TutorialDemo}" Click="TutorialDemo_Click" AutomationProperties.Name="{DynamicResource TutorialDemoName}"/><Button x:Name="TutorialPreviousButton" Content="{DynamicResource TutorialPrevious}" Click="TutorialPrevious_Click" AutomationProperties.Name="{DynamicResource TutorialPreviousName}"/><Button x:Name="TutorialNextButton" Content="{DynamicResource TutorialNext}" Click="TutorialNext_Click" AutomationProperties.Name="{DynamicResource TutorialNextName}"/><Button x:Name="TutorialSkipButton" Content="{DynamicResource TutorialSkip}" Click="TutorialSkip_Click" AutomationProperties.Name="{DynamicResource TutorialSkipName}"/></WrapPanel><Button x:Name="TutorialRerunButton" Content="{DynamicResource TutorialRerun}" Click="TutorialRerun_Click" AutomationProperties.Name="{DynamicResource TutorialRerunName}"/></StackPanel></Expander><Expander x:Name="GuidePanel" Header="{DynamicResource GuideHeader}" IsExpanded="False" Margin="0,8,0,0"><StackPanel Margin="0,8"><Button Content="{DynamicResource GuideStartTutorial}" Click="TutorialRerun_Click" AutomationProperties.Name="{DynamicResource GuideStartTutorialName}"/><ComboBox x:Name="GuideCategorySelector" DisplayMemberPath="Title" SelectedValuePath="Id" SelectionChanged="GuideCategory_SelectionChanged" AutomationProperties.Name="{DynamicResource GuideCategoryName}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,4"><Button x:Name="GuidePreviousButton" Content="←" Click="GuidePrevious_Click" AutomationProperties.Name="{DynamicResource GuidePreviousName}"/><Button x:Name="GuideNextButton" Content="→" Click="GuideNext_Click" Margin="8,3,0,3" AutomationProperties.Name="{DynamicResource GuideNextName}"/></StackPanel><TextBlock x:Name="GuideTitleText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/><TextBlock x:Name="GuideBodyText" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.Name="{DynamicResource GuideBodyName}"/></StackPanel></Expander><Button x:Name="DiagnosticButton" Content="{DynamicResource SaveDiagnostic}" Click="SaveDiagnostic_Click" HorizontalContentAlignment="Center" Margin="0,8,0,0" AutomationProperties.HelpText="Local metadata only; ROM, save data, user name, and paths are excluded."/>
        <Expander Header="{DynamicResource DiagnosticHeader}" Margin="0,8,0,0"><TextBlock x:Name="DiagnosticText" Text="エラーコードはありません。" TextWrapping="Wrap"/></Expander>
        <TextBlock Text="{DynamicResource BackupRestoreHeading}" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock Text="{DynamicResource RestoreHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="BackupIdText" TextChanged="Input_TextChanged" Margin="0,7,0,4" AutomationProperties.Name="Backup ID"/><Button x:Name="RestoreButton" IsEnabled="False" Content="{DynamicResource RestoreNew}" Click="Restore_Click" HorizontalContentAlignment="Center"/>
        <Expander Header="Advanced" Margin="0,18,0,0"><StackPanel Margin="0,8"><TextBlock Text="{DynamicResource PackTrustHeading}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource PackTrustHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{DynamicResource PackSection}" FontWeight="SemiBold" Margin="0,12,0,0"/><Button x:Name="InstallPackButton" Content="{DynamicResource InstallPack}" Click="InstallPack_Click" HorizontalContentAlignment="Center" Margin="0,6,0,6"/><TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource PackName}"/><Run Text=": "/><Run x:Name="PackNameText" Text="—"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource PackVersion}"/><Run Text=": "/><Run x:Name="PackVersionText" Text="—"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource PackStatus}"/><Run Text=": "/><Run x:Name="PackStatusText" Text="Not installed"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource PackPublisher}"/><Run Text=": "/><Run x:Name="PackPublisherText" Text="—"/></TextBlock><TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource PackSignature}"/><Run Text=": "/><Run x:Name="PackSignatureText" Text="Not verified"/></TextBlock></StackPanel></Expander>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6"><TextBlock Text="v0.1.0  •  Windows 11 x64  •  Local only  •  Telemetry: none" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Border>
  </Grid>
</Window>
