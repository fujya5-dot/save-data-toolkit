{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuni-retro-toolkit:schema:game-definition-pack-manifest:1.0.0",
  "title": "Yuni Retro Toolkit Game Definition Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packFormat",
    "packageId",
    "packageVersion",
    "createdAt",
    "publisher",
    "minimumAppVersion",
    "definitionSchemaVersions",
    "contents"
  ],
  "properties": {
    "packFormat": {
      "const": "yrtpack-1"
    },
    "packageId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\r\n<>]*$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519:[a-f0-9]{64}$"
        }
      }
    },
    "minimumAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "maximumAppVersionExclusive": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "definitionSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "const": "1.0.0"
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mediaType",
          "sha256",
          "size",
          "definitionId",
          "definitionVersion"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 20,
            "maxLength": 160,
            "pattern": "^definitions/[a-z0-9]+(?:[._-][a-z0-9]+)*\\.yrt-game\\.json$"
          },
          "mediaType": {
            "const": "application/vnd.yuni-retro-toolkit.game-definition+json"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2097152
          },
          "definitionId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "definitionVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "keyId",
        "signaturePath"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "RFC8785-JCS"
        },
        "keyId": {
          "type": "string",
          "pattern": "^ed25519:[a-f0-9]{64}$"
        },
        "signaturePath": {
          "const": "signature.json"
        }
      }
    }
  }
}
